# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used in server-side code that must bypass RLS (e.g. admin scripts).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed app, used to build the OAuth redirect / share links.
NEXT_PUBLIC_SITE_URL=https://shiku-shiku.vercel.app/

# ---------------------------------------------------------------------------
# Optional: Google Document AI, used to read scanned/photographed vocab sheets
# that have no text layer. Leave these unset and PDF import still works for
# normal text PDFs -- the OCR template is simply hidden.
# Setup: docs/pdf-import.md
# ---------------------------------------------------------------------------
# GOOGLE_DOCAI_PROJECT_ID=your-gcp-project-id
# GOOGLE_DOCAI_PROCESSOR_ID=your-form-parser-processor-id
# GOOGLE_DOCAI_LOCATION=us
# Service-account JSON key: paste it raw, or base64-encoded.
# GOOGLE_SERVICE_ACCOUNT_JSON=
